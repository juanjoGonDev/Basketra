{
  "name": "@basketra/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "volta": {
    "node": "22.23.1"
  },
  "scripts": {
    "predev": "node scripts/check-dev-runtime.mjs",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/main.ts",
    "dev:docker": "docker compose up --build --force-recreate basketra",
    "dev:docker:down": "docker compose down",
    "start": "node dist/main.js",
    "format:check": "node scripts/format-check.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "deadcode": "node scripts/deadcode.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/domain/*.ts' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test tests/unit/*.test.ts",
    "test:coverage:receipt-ai-backend": "node scripts/check-diff-coverage.mjs src/ai/provider.ts src/ai/structured-executor.ts src/api/errors.ts src/receipts/service.ts src/operations/gateway.ts",
    "test:coverage:receipt-ai-recovery": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/web/receipt-ai-recovery.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test tests/unit/receipt-ai-recovery.test.ts",
    "test:coverage:service-worker": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/web/sw.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test tests/unit/service-worker-shell.test.ts",
    "build": "node scripts/build.mjs",
    "docker:build": "docker build -t basketra:local .",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "resource:measure": "node scripts/build.mjs && node --expose-gc scripts/resource-measure.mjs",
    "quality": "node scripts/run-quality.mjs",
    "postinstall": "node scripts/install-hooks.mjs",
    "hook:pre-commit": "lefthook run pre-commit",
    "hook:pre-push": "lefthook run pre-push",
    "test:browser": "playwright test"
  },
  "exports": {
    ".": "./src/public-api.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "lefthook": "2.1.8"
  }
}
