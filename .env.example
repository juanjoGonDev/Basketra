BASKETRA_IMAGE=ghcr.io/juanjogondev/basketra:stable
BASKETRA_BIND_ADDRESS=127.0.0.1
BASKETRA_HOST=127.0.0.1
BASKETRA_PORT=3000
BASKETRA_DATA_DIR=/data
BASKETRA_TEMP_DIR=/tmp/basketra
BASKETRA_MAX_BODY_BYTES=8388608
BASKETRA_AI_BASE_URL=
BASKETRA_AI_API_KEY=
BASKETRA_AI_MODEL=
BASKETRA_AI_TIMEOUT_MS=30000
BASKETRA_AI_MAX_RETRIES=1
BASKETRA_AI_IMAGE_CAPABILITY=true
BASKETRA_AI_PDF_CAPABILITY=false
BASKETRA_IDLE_HIBERNATE_AFTER_MS=300000
IDLE_EXIT_AFTER_MS=0
BASKETRA_NODE_HEAP_MB=128
BASKETRA_MEMORY_LIMIT=192m
BASKETRA_CPU_LIMIT=0.75
BASKETRA_DOCKER_CONFIG_DIR=./.docker
WATCHTOWER_DOCKER_API_VERSION=1.52
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_MEMORY_LIMIT=128m
WATCHTOWER_CPU_LIMIT=0.25
TZ=Europe/Madrid
