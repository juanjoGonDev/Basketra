# Keep exactly one NAME=value entry per line.
# After changing this file, recreate Basketra with:
# docker compose -f compose.raspberry.yml up -d --force-recreate basketra
BASKETRA_IMAGE=ghcr.io/juanjogondev/basketra:stable
BASKETRA_BIND_ADDRESS=127.0.0.1
BASKETRA_HOST=127.0.0.1
BASKETRA_PORT=3000
BASKETRA_DATA_DIR=/data
BASKETRA_TEMP_DIR=/tmp/basketra
BASKETRA_MAX_BODY_BYTES=8388608
# For an OpenAI-compatible provider running on the Raspberry host, use:
# BASKETRA_AI_BASE_URL=http://host.docker.internal:3001/v1/
BASKETRA_AI_BASE_URL=
# For webApi, create a managed token in /admin and copy its one-time value here.
# The removed webApi API_KEY environment variable is not a valid replacement.
BASKETRA_AI_API_KEY=
BASKETRA_AI_MODEL=
# Basketra does not impose an end-to-end inference deadline. Provider/webApi timeouts remain authoritative.
BASKETRA_AI_TIMEOUT_MS=0
BASKETRA_AI_MAX_RETRIES=1
BASKETRA_AI_IMAGE_CAPABILITY=true
# Set true only when the configured provider accepts PDF file attachments; webApi does.
BASKETRA_AI_PDF_CAPABILITY=false
BASKETRA_IDLE_HIBERNATE_AFTER_MS=300000
IDLE_EXIT_AFTER_MS=0
BASKETRA_NODE_HEAP_MB=128
BASKETRA_MEMORY_LIMIT=192m
BASKETRA_CPU_LIMIT=0.75
BASKETRA_DOCKER_CONFIG_DIR=./.docker
WATCHTOWER_DOCKER_API_VERSION=1.52
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_MEMORY_LIMIT=128m
WATCHTOWER_CPU_LIMIT=0.25
TZ=Europe/Madrid
